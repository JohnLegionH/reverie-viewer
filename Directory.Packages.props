<Project>
  <!--
    Central package management. Every version is exact and pinned; lock files (packages.lock.json)
    are committed for every project, so transitive versions are pinned too (ADR-007). Upgrades only
    through a tested, recorded bump.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- MessagePack reaches the build only through LibreMetaverse.Types, so its version is pinned here for the
         graph (transitive pinning) instead of by a reference. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Protocol library (ADR-007): exactly 3.3.0-reverie.2. It pulls in its Assets, Protocol and Transport packages; the lock files pin them.
         3.3.0 and not 3.2.1: 3.2.1 hashes only the first 16 characters of the password for every grid; 3.3.0 does so only on Second Life.
         3.3.0-reverie.2 is LibreMetaverse 3.3.0 plus one fix, built from a fork and kept in the folder feed nuget-feed\ with its six
         split packages (nuget.config maps LibreMetaverse and LibreMetaverse.* to that feed): a teleport whose destination never answers
         CompleteAgentMovement no longer moves the agent there; a TeleportFailed during that wait ends it, and the agent stays in its
         region, as in the Second Life viewer. Source: THIRD-PARTY-NOTICES.md. Exact pin. -->
    <PackageVersion Include="LibreMetaverse" Version="[3.3.0-reverie.2]" />

    <!-- JPEG 2000 decoder. LibreMetaverse depends on CoreJ2K 2.4.1.108 or later; the viewer references it directly so this
         version wins over the one LibreMetaverse names. It is a pre-release build of a fork of CoreJ2K 2.4.1 at one commit, from
         the folder feed nuget-feed\ (nuget.config maps CoreJ2K to that feed): a reduced-resolution decode allocates for the
         picture it returns, not the full picture. The assembly version is 2.4.1.109, which is not below the version
         LibreMetaverse names (a lower assembly version fails to load). Rebuild: tools\rebuild-corej2k.ps1. Exact pin. -->
    <PackageVersion Include="CoreJ2K" Version="[2.4.1.109-alloc.1]" />

    <!-- Transitive, via LibreMetaverse.Types. 3.1.9 fixes GHSA-qhrr-8q5h-9q3h (nested arrays could pass the
         buffer length limits); every version below 3.1.9 from 3.0.0 on is affected. LibreMetaverse 3.3.0 asks for 3.1.12 or later. Exact pin. -->
    <PackageVersion Include="MessagePack" Version="[3.1.12]" />

    <!-- Parcel music decoders (all managed, MIT; notices in ThirdPartyLicenses and THIRD-PARTY-NOTICES.md). NLayer reads MP3 (MPEG-1/2/2.5
         layers I to III), NVorbis reads Ogg Vorbis, SharpJaad.AAC reads AAC-LC and HE-AAC frames (a C# port of the JAAD decoder). They read
         the stream in the managed host; none of them needs a native library. Exact pins. -->
    <PackageVersion Include="NLayer" Version="[3.0.1]" />
    <PackageVersion Include="NVorbis" Version="[0.10.5]" />
    <PackageVersion Include="SharpJaad.AAC" Version="[0.2.0]" />

    <!-- Jolt binding (ADR-009): pinned exactly as the grid pins it. The patched joltc is built from
         the joltc commit behind JoltPhysics.Native 1.0.4, so the managed binding cannot move without
         rebuilding the patch (native/joltc/README.md). -->
    <PackageVersion Include="JoltPhysicsSharp" Version="[2.19.1]" />

    <!-- The content store's key protected with Windows DPAPI (CurrentUser). Exact pin. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="[10.0.12]" />
    <PackageVersion Include="JoltPhysics.Native" Version="[1.0.4]" />

    <!-- Negative-control fixture only (core/Viewer.Core.ArchFixture). Never referenced by product code.
         Not defined for Viewer.Godot: Godot.NET.Sdk/4.7.2 references GodotSharp 4.7.2 implicitly, and CPM rejects a
         central version for an implicit reference (NU1009). -->
    <PackageVersion Include="GodotSharp" Version="[4.7.2]" Condition="'$(MSBuildProjectName)' != 'Viewer.Godot'" />

    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="JunitXml.TestLogger" Version="6.1.0" />
  </ItemGroup>
</Project>
