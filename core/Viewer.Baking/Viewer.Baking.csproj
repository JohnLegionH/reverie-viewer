<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Viewer.Baking: the avatar bake compositor, for regions that do not bake on the server.
    Source brought in from the OpenSimNGC.Appearance.Baking library (see THIRD-PARTY-NOTICES.md), with its file headers kept.
    Changes from that library: no SkiaSharp (nothing here needs it), no embedded Linden data (avatar_lad.xml and the
    character images are read from the viewer's character folder at run time and never shipped), and
    CoreJ2K comes from the version the viewer pins.
    The only OpenMetaverse type used is UUID (from the LibreMetaverse package); it does not cross into Viewer.Core's
    public surface, only the Viewer.Core.Protocol adapter uses this project.
  -->
  <PropertyGroup>
    <RootNamespace>OpenSimNGC.Appearance.Baking</RootNamespace>
    <AssemblyName>Viewer.Baking</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1570;CS1572;CS1573;CS1587;CS1574</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreMetaverse" ExcludeAssets="$(NvLibreMetaverseExcludeAssets)" />
    <PackageReference Include="CoreJ2K" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Viewer.Core.Tests" />
  </ItemGroup>

</Project>
