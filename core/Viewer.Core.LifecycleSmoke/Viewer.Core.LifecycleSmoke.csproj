<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Physics lifecycle smoke (console, no Godot). Runs N create/destroy cycles of a
    PhysicsWorld in its own process, so leaked threads from a failing run never pollute another suite.
    Driven by Viewer.Core.Tests (PhysicsLifecycleTests); also runnable by hand.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Viewer.Core.LifecycleSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viewer.Core\Viewer.Core.csproj" />
    <!-- Same suppression as Viewer.Core: the transitive stock native must not reach this output either. -->
    <PackageReference Include="JoltPhysics.Native" ExcludeAssets="all" />
  </ItemGroup>

</Project>
