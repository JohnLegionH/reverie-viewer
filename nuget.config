<?xml version="1.0" encoding="utf-8"?>
<!-- Two sources, each mapped to what it serves, so a fresh clone restores the same pinned packages on any machine
     (and central package management has no source ambiguity, NU1507):
       nuget.org   every package except CoreJ2K and LibreMetaverse;
       local-feed  the folder nuget-feed\ in this repository, which holds the builds of forks the viewer uses:
                   CoreJ2K (tools\rebuild-corej2k.ps1 rebuilds it), and LibreMetaverse with its six split packages
                   (built from a fork; THIRD-PARTY-NOTICES.md names the commit).
     The folder path is relative to this file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-feed" value="nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-feed">
      <package pattern="CoreJ2K" />
      <package pattern="LibreMetaverse" />
      <package pattern="LibreMetaverse.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
