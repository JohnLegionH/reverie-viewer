        <key>water_fog_density</key><real>10</real>
        <key>wave1_direction</key><array><real>1.0</real><real>-0.5</real></array>
        <key>wave2_direction</key><array><real>0.8</real><real>-1.2</real></array>
        <key>fresnel_scale</key><real>0.4</real>
        <key>fresnel_offset</key><real>0.5</real>
      </map>
      <key>sky_dawn</key><map>
        <key>type</key><string>sky</string><key>reflection_probe_ambiance</key><real>1</real>
        <key>sun_rotation</key><array><real>0</real><real>-0.02618</real><real>0</real><real>0.99966</real></array>
        <key>moon_rotation</key><array><real>0</real><real>0.99966</real><real>0</real><real>0.02618</real></array>
        <key>moon_brightness</key><real>0.5</real>
        <key>sunlight_color</key><array><real>0.73</real><real>0.78</real><real>0.9</real><real>1</real></array>
        <key>legacy_haze</key><map>
          <key>ambient</key><array><real>0.35</real><real>0.3</real><real>0.35</real></array>
          <key>blue_horizon</key><array><real>0.5</real><real>0.5</real><real>0.64</real></array>
          <key>blue_density</key><array><real>0.2447</real><real>0.4487</real><real>0.7599</real></array>
          <key>haze_horizon</key><real>0.19</real>
          <key>haze_density</key><real>3.0</real>
          <key>density_multiplier</key><real>0.0004</real>
          <key>distance_multiplier</key><real>0.8</real>
