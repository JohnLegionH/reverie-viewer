<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The interface sound generator. Every sound the viewer ships for its interface is made from code (tones, FM bells, filtered
    noise, envelopes, a gentle low-pass) and written as a 16-bit mono 44.1 kHz WAV. The recipes and the synthesizer are the shell's
    own files (host/Viewer.Shell/Sound/UiSoundSynth.cs), compiled here as well, so the viewer's Sound Tuner and the generator make the
    same bytes. The WAVs in host/Viewer.Shell/Assets/Sounds are the output, committed. Running it twice gives the same bytes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>UiSoundGen</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\host\Viewer.Shell\Sound\UiSoundSynth.cs" Link="Shared\UiSoundSynth.cs" />
    <Compile Include="..\..\host\Viewer.Shell\Sound\UiSoundTuning.cs" Link="Shared\UiSoundTuning.cs" />
    <Compile Include="..\..\host\Viewer.Shell\Sound\WavFile.cs" Link="Shared\WavFile.cs" />
    <Compile Include="..\..\host\Viewer.Shell\Sound\Loudness.cs" Link="Shared\Loudness.cs" />
    <Compile Include="..\..\host\Viewer.Shell\Sound\UiSoundFit.cs" Link="Shared\UiSoundFit.cs" />
    <Compile Include="..\..\host\Viewer.Shell\Sound\UiSoundCatalog.cs" Link="Shared\UiSoundCatalog.cs" />
    <Compile Include="..\..\host\Viewer.Shell\Sound\UiSoundRecordings.cs" Link="Shared\UiSoundRecordings.cs" />
  </ItemGroup>

</Project>
